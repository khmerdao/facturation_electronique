# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Application
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
APP_ENV=dev
APP_SECRET=change_me_in_production_32chars_min
APP_DEBUG=true

# URL publique de l'application (sans trailing slash)
APP_URL=http://localhost:8000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Base de données (PostgreSQL)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/facturation?serverVersion=8.0&charset=utf8mb4"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Redis (cache + Messenger + sessions)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
REDIS_URL=redis://localhost:6379

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# JWT (LexikJWT)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_in_production
# Durée de vie du token JWT en secondes (1 heure)
JWT_TTL=3600

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Mailer (SMTP)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MAILER_DSN=smtp://localhost:1025
MAILER_FROM_ADDRESS=no-reply@facturation.app
MAILER_FROM_NAME="Facturation Électronique"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Stockage S3 / MinIO
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
S3_ENDPOINT=http://localhost:9000
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_REGION=eu-west-3
S3_BUCKET_INVOICES=invoices
S3_BUCKET_ATTACHMENTS=attachments
S3_BUCKET_EXPORTS=exports
S3_BUCKET_TEMPLATES=templates
# true pour MinIO (path-style), false pour AWS S3 (virtual-hosted)
S3_PATH_STYLE_ENDPOINT=true
# Durée de validité des URLs signées S3 (en secondes)
S3_PRESIGNED_TTL=3600

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Chiffrement (AES-256 pour les secrets PDP, clés API, TOTP)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=change_me_in_production_base64_key

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# API externes
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Vérification SIRET (API Sirene INSEE)
SIRENE_API_URL=https://api.insee.fr/entreprises/sirene/V3.11
SIRENE_API_KEY=

# Vérification numéro TVA intracommunautaire (VIES)
VIES_WSDL_URL=https://ec.europa.eu/taxation_customs/vies/checkVatService.wsdl

# Taux de change BCE (fallback si aucune API configurée)
ECB_EXCHANGE_URL=https://data-api.ecb.europa.eu/service/data/EXR

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Réglementation française
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PPF (Portail Public de Facturation) — Chorus Pro API
PPF_API_URL=https://api.chorus-pro.gouv.fr
PPF_API_KEY=

# Indemnité forfaitaire recouvrement (art. L.441-10 C.com.)
LATE_PAYMENT_RECOVERY_FEE=40.00

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Messenger / Workers
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Nombre de retries sur les messages async
MESSENGER_RETRY_MAX=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SaaS / Plan
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Durée de rétention des logs d'export (jours)
EXPORT_RETENTION_DAYS=7
# Durée de rétention des audit logs (années légales)
AUDIT_LOG_RETENTION_YEARS=10

###> symfony/mailer ###
###< symfony/mailer ###
