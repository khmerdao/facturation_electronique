{% extends 'base.html.twig' %}
{% block page_title %}Admin — Logs{% endblock %}
{% block main %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 mb-0 fw-bold">Journal super-admin</h1>
    <a href="{{ path('admin_tenants') }}" class="btn btn-outline-secondary btn-sm">← Organisations</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Date</th><th>Admin</th><th>Organisation</th><th>Action</th><th>IP</th></tr>
            </thead>
            <tbody>
                {% for log in logs %}
                <tr>
                    <td>{{ log.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="small">{{ log.superAdmin.email }}</td>
                    <td>
                        {% if log.targetTenant %}
                        <a href="{{ path('admin_tenant_show', {id: log.targetTenant.id}) }}">
                            {{ log.targetTenantName ?? log.targetTenant.name }}
                        </a>
                        {% else %}{{ log.targetTenantName ?? '—' }}{% endif %}
                    </td>
                    <td><span class="badge bg-dark">{{ log.action }}</span></td>
                    <td class="text-muted small">{{ log.ipAddress ?? '—' }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-muted py-5">Aucun log.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
