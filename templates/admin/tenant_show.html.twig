{% extends 'base.html.twig' %}
{% block page_title %}Admin — {{ tenant.name }}{% endblock %}
{% block main %}
<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('admin_tenants') }}" class="btn btn-sm btn-outline-secondary">← Retour</a>
    <h1 class="h4 mb-0 fw-bold">{{ tenant.name }}</h1>
    <span class="badge bg-{{ tenant.status.value == 'ACTIVE' ? 'success' : 'danger' }}">{{ tenant.status.value }}</span>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="mb-2"><div class="text-muted small">Plan</div>
                    <span class="badge bg-primary fs-6">{{ tenant.plan.label() }}</span></div>
                <div class="mb-2"><div class="text-muted small">SIRET</div><div>{{ tenant.siret ?? '—' }}</div></div>
                <div class="mb-2"><div class="text-muted small">TVA</div><div>{{ tenant.tvaIntra ?? '—' }}</div></div>
                <div class="mb-2"><div class="text-muted small">Email facturation</div><div>{{ tenant.billingEmail ?? '—' }}</div></div>
                <div class="mb-2"><div class="text-muted small">Créé le</div><div>{{ tenant.createdAt|date('d/m/Y') }}</div></div>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header fw-semibold bg-transparent">Changer le plan</div>
            <div class="card-body">
                <form method="POST" action="{{ path('admin_tenant_plan', {id: tenant.id}) }}" class="d-flex gap-2">
                    <select name="plan" class="form-select form-select-sm">
                        {% for plan in plans %}
                        <option value="{{ plan.value }}" {{ tenant.plan.value == plan.value ? 'selected' : '' }}>{{ plan.label() }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm flex-shrink-0">Changer</button>
                </form>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-semibold bg-transparent">Actions</div>
            <div class="card-body d-grid gap-2">
                {% if tenant.status.value == 'ACTIVE' %}
                <form method="POST" action="{{ path('admin_tenant_suspend', {id: tenant.id}) }}">
                    <input type="hidden" name="suspend" value="1">
                    <button type="submit" class="btn btn-warning btn-sm w-100">Suspendre</button>
                </form>
                {% elseif tenant.status.value == 'SUSPENDED' %}
                <form method="POST" action="{{ path('admin_tenant_suspend', {id: tenant.id}) }}">
                    <input type="hidden" name="suspend" value="0">
                    <button type="submit" class="btn btn-success btn-sm w-100">Réactiver</button>
                </form>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header fw-semibold bg-transparent">Journal des actions super-admin</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>Date</th><th>Action</th><th>Admin</th><th>IP</th></tr></thead>
                    <tbody>
                        {% for log in logs %}
                        <tr>
                            <td>{{ log.createdAt|date('d/m/Y H:i') }}</td>
                            <td><span class="badge bg-dark">{{ log.action }}</span></td>
                            <td>{{ log.superAdmin.email }}</td>
                            <td class="text-muted small">{{ log.ipAddress ?? '—' }}</td>
                        </tr>
                        {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-4">Aucune action enregistrée.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
