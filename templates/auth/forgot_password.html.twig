<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mot de passe oublié — {{ app_name }}</title>
    {{ encore_entry_link_tags('app') }}
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh">
<div class="container" style="max-width:420px">

    <div class="text-center mb-4">
        <h1 class="h4 fw-bold">Mot de passe oublié</h1>
        <p class="text-muted">Saisissez votre email pour recevoir un lien de réinitialisation.</p>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            {% if sent %}
                <div class="alert alert-success">
                    Si un compte existe pour cette adresse, vous recevrez un email dans quelques minutes.
                </div>
                <div class="text-center">
                    <a href="{{ path('app_login') }}" class="btn btn-outline-secondary">Retour à la connexion</a>
                </div>
            {% else %}
                <form method="POST" action="{{ path('app_forgot_password') }}" novalidate>
                    <div class="mb-3">
                        <label for="email" class="form-label fw-medium">Adresse email</label>
                        <input type="email" id="email" name="email" class="form-control" required autofocus>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary fw-medium">Envoyer le lien</button>
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">
</form>
            {% endif %}

        </div>
    </div>

    <p class="text-center text-muted mt-3 small">
        <a href="{{ path('app_login') }}">Retour à la connexion</a>
    </p>
</div>
{{ encore_entry_script_tags('app') }}
</body>
</html>
