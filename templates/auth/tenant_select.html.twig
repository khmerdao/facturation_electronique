<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Choisir une organisation — {{ app_name }}</title>
    {{ encore_entry_link_tags('app') }}
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh">
<div class="container" style="max-width:480px">

    <div class="text-center mb-4">
        <h1 class="h4 fw-bold">Choisir une organisation</h1>
        <p class="text-muted">Sélectionnez l'espace auquel vous souhaitez accéder.</p>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form method="POST" action="{{ path('app_tenant_select') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('tenant_select') }}">

                <div class="list-group list-group-flush mb-3">
                    {% for membership in memberships %}
                        {% set tenant = membership.tenant %}
                        <button type="submit" name="tenant_id" value="{{ tenant.id }}"
                                class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-0 rounded-2 mb-1">
                            <span class="rounded-2 d-flex align-items-center justify-content-center fw-bold text-white"
                                  style="width:40px;height:40px;background:{{ tenant.brandColor|default('#2563EB') }};font-size:.85rem;flex-shrink:0">
                                {{ tenant.name|first|upper }}
                            </span>
                            <div class="text-start">
                                <div class="fw-semibold">{{ tenant.name }}</div>
                                <div class="small text-muted">{{ membership.role.value|capitalize }}</div>
                            </div>
                            <svg class="ms-auto text-muted" width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                            </svg>
                        </button>
                    {% endfor %}
                </div>
            </form>
        </div>
    </div>

    <p class="text-center text-muted mt-3 small">
        <a href="{{ path('app_logout') }}" data-turbo="false">Se déconnecter</a>
    </p>
</div>
{{ encore_entry_script_tags('app') }}
</body>
</html>
