{% extends 'base.html.twig' %}
{% block page_title %}Tableau de bord{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.kpi-card { border-left: 4px solid transparent; transition: transform .15s; }
.kpi-card:hover { transform: translateY(-2px); }
.kpi-card--blue   { border-left-color: #2563eb; }
.kpi-card--green  { border-left-color: #16a34a; }
.kpi-card--orange { border-left-color: #d97706; }
.kpi-card--red    { border-left-color: #dc2626; }
.kpi-value { font-size: 1.75rem; font-weight: 700; letter-spacing: -.02em; line-height: 1; }
.alert-row { border-left: 3px solid #f59e0b; background: #fffbeb; }
</style>
{% endblock %}

{% block main %}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h4 mb-0 fw-bold">Tableau de bord</h1>
        <p class="text-muted small mb-0">{{ 'now'|date_month_year_fr|capitalize }} — {{ tenant.name }}</p>
    </div>
    <a href="{{ path('app_invoices_new') }}" class="btn btn-primary">+ Nouvelle facture</a>
</div>

{# KPIs #}
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm kpi-card kpi-card--blue">
            <div class="card-body">
                <div class="text-muted small mb-1">CA du mois (TTC)</div>
                <div class="kpi-value text-primary">{{ kpis.totalSent is defined and kpis.totalSent ? kpis.totalSent|money : '0 €' }}</div>
                <div class="text-muted small mt-1">Factures transmises</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm kpi-card kpi-card--green">
            <div class="card-body">
                <div class="text-muted small mb-1">Encaissé</div>
                <div class="kpi-value text-success">{{ kpis.totalPaid is defined and kpis.totalPaid ? kpis.totalPaid|money : '0 €' }}</div>
                <div class="text-muted small mt-1">Factures réglées ce mois</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm kpi-card kpi-card--orange">
            <div class="card-body">
                <div class="text-muted small mb-1">En attente</div>
                <div class="kpi-value" style="color:#d97706">{{ kpis.totalAcknowledged is defined and kpis.totalAcknowledged ? kpis.totalAcknowledged|money : '0 €' }}</div>
                <div class="text-muted small mt-1">Acceptées non réglées</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm kpi-card kpi-card--red">
            <div class="card-body">
                <div class="text-muted small mb-1">En retard</div>
                <div class="kpi-value text-danger">{{ overdueInvoices|length }}</div>
                <div class="text-muted small mt-1">Factures échues non réglées</div>
            </div>
        </div>
    </div>
</div>

{# Alertes #}
{% if overdueInvoices|length > 0 or pendingAck|length > 0 or ereportingDue|length > 0 %}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent">⚠ Alertes</div>
    <div class="list-group list-group-flush">
        {% if overdueInvoices|length > 0 %}
        <div class="list-group-item alert-row d-flex align-items-center justify-content-between">
            <div>
                <strong>{{ overdueInvoices|length }} facture(s) en retard</strong>
                <div class="text-muted small">Échéance dépassée, paiement non reçu.</div>
            </div>
            <a href="{{ path('app_invoices_index') }}?status=ACKNOWLEDGED" class="btn btn-sm btn-outline-warning">Voir</a>
        </div>
        {% endif %}
        {% if pendingAck|length > 0 %}
        <div class="list-group-item alert-row d-flex align-items-center justify-content-between">
            <div>
                <strong>{{ pendingAck|length }} acquittement(s) technique(s) à envoyer</strong>
                <div class="text-muted small">Obligatoire dans les 5 jours ouvrés (réforme 2026).</div>
            </div>
            <a href="{{ path('app_received_invoices_index') }}" class="btn btn-sm btn-outline-warning">Voir</a>
        </div>
        {% endif %}
        {% if ereportingDue|length > 0 %}
        <div class="list-group-item alert-row d-flex align-items-center justify-content-between">
            <div>
                <strong>{{ ereportingDue|length }} lot(s) e-reporting à soumettre</strong>
                <div class="text-muted small">Transmission DGFiP imminente.</div>
            </div>
            <a href="{{ path('app_e_reporting_index') }}" class="btn btn-sm btn-outline-warning">Voir</a>
        </div>
        {% endif %}
    </div>
</div>
{% endif %}

{# Graphique + dernières factures #}
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold bg-transparent">CA — 12 derniers mois</div>
            <div class="card-body">
                {% if monthlyRevenue|length > 0 %}
                    <canvas height="220"
                        data-controller="chart"
                        data-chart-config-value="{{ {
                            type: 'bar',
                            data: {
                                labels: monthlyRevenue|map(r => r.label ?? r.month),
                                datasets: [{
                                    label: 'CA TTC',
                                    data: monthlyRevenue|map(r => r.total|default(0)),
                                    backgroundColor: 'rgba(37,99,235,.15)',
                                    borderColor: '#2563eb',
                                    borderWidth: 2,
                                    borderRadius: 4,
                                    borderSkipped: false
                                }]
                            },
                            options: {
                                responsive: true,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: { callbacks: {} }
                                },
                                scales: {
                                    y: { beginAtZero: true },
                                    x: { grid: { display: false } }
                                }
                            }
                        }|json_encode|e('html_attr') }}">
                    </canvas>
                {% else %}
                    <div class="text-center text-muted py-5">Aucune donnée de chiffre d'affaires pour le moment.</div>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold bg-transparent d-flex justify-content-between align-items-center">
                Dernières factures
                <a href="{{ path('app_invoices_index') }}" class="btn btn-sm btn-outline-secondary">Tout voir</a>
            </div>
            <div class="list-group list-group-flush">
                {% for invoice in recentInvoices %}
                <a href="{{ path('app_invoices_show', {id: invoice.id}) }}" class="list-group-item list-group-item-action py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">{{ invoice.number ?? 'Brouillon' }}</div>
                            <div class="text-muted small">{{ invoice.clientNameSnapshot ?? invoice.contact?.name ?? '—' }}</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-semibold">{{ invoice.totalTtc|money }}</div>
                            {{ invoice_status_badge(invoice.status) }}
                        </div>
                    </div>
                </a>
                {% else %}
                <div class="list-group-item text-muted text-center py-4">
                    Aucune facture. <a href="{{ path('app_invoices_new') }}">Créer la première</a>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{# Accès rapides #}
<div class="card border-0 shadow-sm">
    <div class="card-header fw-semibold bg-transparent">Accès rapides</div>
    <div class="card-body d-flex flex-wrap gap-2">
        <a href="{{ path('app_invoices_new') }}" class="btn btn-outline-primary">📄 Nouvelle facture</a>
        <a href="{{ path('app_contacts_new') }}" class="btn btn-outline-secondary">👤 Nouveau contact</a>
        <a href="{{ path('app_received_invoices_index') }}" class="btn btn-outline-secondary">📥 Factures reçues</a>
        <a href="{{ path('app_e_reporting_index') }}" class="btn btn-outline-secondary">📊 E-reporting</a>
        <a href="{{ path('app_tax_index') }}" class="btn btn-outline-secondary">🧾 TVA & Exports</a>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
{% endblock %}
