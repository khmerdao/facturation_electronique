{% extends 'base.html.twig' %}
{% block page_title %}E-reporting DGFiP{% endblock %}
{% block main %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 mb-0 fw-bold">E-reporting DGFiP</h1>
</div>

{% if late|length > 0 %}
<div class="alert alert-danger mb-4">
    <strong>⚠ {{ late|length }} lot(s) en retard !</strong>
    Veuillez soumettre ces lots à la DGFiP immédiatement.
</div>
{% endif %}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent d-flex justify-content-between align-items-center">
        Générer un lot
    </div>
    <div class="card-body">
        <form method="POST" action="{{ path('app_e_reporting_generate') }}" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-medium">Période</label>
                <input type="month" name="period" class="form-control" value="{{ 'now'|date('Y-m') }}">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Générer le lot</button>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('ereporting_generate') }}">
</form>
        <p class="text-muted small mt-2">Format : AAAA-MM pour mensuel (ex: 2026-09)</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header fw-semibold bg-transparent">Lots e-reporting</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Période</th><th>Périodicité</th><th>Échéance</th><th>Statut</th><th>Nil</th><th>Réf. DGFiP</th><th></th></tr>
            </thead>
            <tbody>
                {% for batch in batches %}
                <tr class="{{ batch.late ? 'table-danger' : '' }}">
                    <td class="fw-semibold">{{ batch.period }}</td>
                    <td><span class="badge bg-secondary">{{ batch.periodicity.value }}</span></td>
                    <td class="{{ batch.late ? 'text-danger fw-bold' : '' }}">
                        {{ batch.deadline|date_fr }}
                        {% if batch.late %}<span class="badge bg-danger ms-1">En retard</span>{% endif %}
                    </td>
                    <td>
                        <span class="badge bg-{{ batch.status.value in ['ACCEPTED'] ? 'success' : (batch.status.value in ['REJECTED','LATE'] ? 'danger' : (batch.status.value == 'SUBMITTED' ? 'primary' : 'secondary')) }}">
                            {{ batch.status.value }}
                        </span>
                    </td>
                    <td>{{ batch.nil ? '<span class="text-muted">Néant</span>'|raw : '' }}</td>
                    <td class="font-monospace small text-muted">{{ batch.dgfipReference ?? '—' }}</td>
                    <td><a href="{{ path('app_e_reporting_show', {id: batch.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a></td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-muted py-5">Aucun lot e-reporting. Générez le premier ci-dessus.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
