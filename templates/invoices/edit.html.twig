{% extends 'base.html.twig' %}
{% block page_title %}Modifier — {{ invoice.number ?? 'Brouillon' }}{% endblock %}

{% block main %}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('app_invoices_show', {id: invoice.id}) }}"
       class="btn btn-sm btn-outline-secondary">← Retour</a>
    <h1 class="h4 mb-0 fw-bold">Modifier la facture</h1>
    {% if invoice.number %}
        <span class="badge bg-secondary fs-6">{{ invoice.number }}</span>
    {% endif %}
</div>

{{ include('invoices/_form.html.twig', {
    form_action:   path('app_invoices_edit', {id: invoice.id}),
    csrf_token_id: 'edit_invoice_' ~ invoice.id,
    submit_label:  'Enregistrer les modifications',
    is_edit:       true,
    back_url:      path('app_invoices_show', {id: invoice.id}),
    cancel_url:    path('app_invoices_show', {id: invoice.id}),
    invoice:       invoice,
    contacts:      contacts,
    formats:       formats,
    products:      products,
    sequences:     sequences,
    templates:     templates
}) }}

{% endblock %}
