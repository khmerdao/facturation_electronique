{% extends 'base.html.twig' %}
{% block page_title %}Factures émises{% endblock %}

{% block main %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 mb-0 fw-bold">Factures émises</h1>
    <a href="{{ path('app_invoices_new') }}" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" class="me-1"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/></svg>
        Nouvelle facture
    </a>
</div>

{# Filtres #}
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="GET" class="row g-2 align-items-end">
            <div class="col-md-3">
                <input type="text" name="q" class="form-control form-control-sm" placeholder="Rechercher…" value="{{ filters.search ?? '' }}">
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">Tous les statuts</option>
                    {% for status in statuses %}
                        <option value="{{ status.value }}" {{ filters.status == status.value ? 'selected' : '' }}>
                            {{ status.label() }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <select name="contact_id" class="form-select form-select-sm">
                    <option value="">Tous les clients</option>
                    {% for contact in contacts %}
                        <option value="{{ contact.id }}" {{ filters.contact_id == contact.id|string ? 'selected' : '' }}>
                            {{ contact.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="from" class="form-control form-control-sm" value="{{ filters.from ?? '' }}" placeholder="Du">
            </div>
            <div class="col-md-2">
                <input type="date" name="to" class="form-control form-control-sm" value="{{ filters.to ?? '' }}" placeholder="Au">
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Filtrer</button>
            </div>
        </form>
    </div>
</div>

{# Tableau #}
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Numéro</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th>Échéance</th>
                    <th class="text-end">Montant TTC</th>
                    <th class="text-center">Statut</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for invoice in invoices %}
                <tr>
                    <td>
                        <a href="{{ path('app_invoices_show', {id: invoice.id}) }}" class="fw-semibold text-decoration-none">
                            {{ invoice.number ?? '<em class="text-muted">Brouillon</em>'|raw }}
                        </a>
                        {% if invoice.type.value == 'CREDIT_NOTE' %}
                            <span class="badge bg-warning text-dark ms-1">Avoir</span>
                        {% endif %}
                    </td>
                    <td>{{ invoice.clientNameSnapshot ?? invoice.contact?.name ?? '—' }}</td>
                    <td>{{ invoice.issueDate|date('d/m/Y') }}</td>
                    <td class="{{ invoice.dueDate and invoice.dueDate < date() and invoice.status.value not in ['PAID','CANCELLED'] ? 'text-danger fw-semibold' : '' }}">
                        {{ invoice.dueDate ? invoice.dueDate|date('d/m/Y') : '—' }}
                    </td>
                    <td class="text-end fw-semibold">
                        {{ invoice.totalTtc|number_format(2, ',', ' ') }} {{ invoice.currency }}
                    </td>
                    <td class="text-center">
                        <span class="badge badge-{{ invoice.status.value }}">
                            {{ invoice.status.label() }}
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <a href="{{ path('app_invoices_show', {id: invoice.id}) }}" class="btn btn-outline-secondary" title="Voir">
                                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
                            </a>
                            {% if invoice.pdfS3Key %}
                            <a href="{{ path('app_invoices_download', {id: invoice.id}) }}" class="btn btn-outline-secondary" title="Télécharger PDF">
                                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            </a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        <svg width="40" height="40" viewBox="0 0 20 20" fill="currentColor" class="d-block mx-auto mb-2 opacity-25"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
                        Aucune facture.
                        <a href="{{ path('app_invoices_new') }}">Créer la première</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if pages > 1 %}
    <div class="card-footer">
        <nav>
            <ul class="pagination pagination-sm mb-0 justify-content-center">
                {% for p in 1..pages %}
                <li class="page-item {{ p == page ? 'active' : '' }}">
                    <a class="page-link" href="?{{ app.request.query.all|merge({page:p})|url_encode }}">{{ p }}</a>
                </li>
                {% endfor %}
            </ul>
        </nav>
    </div>
    {% endif %}
</div>
{% endblock %}
