{% extends 'base.html.twig' %}
{% block page_title %}Facture {{ invoice.number ?? 'Brouillon' }}{% endblock %}

{% block main %}
{# En-tête page #}
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_invoices_index') }}" class="btn btn-sm btn-outline-secondary">← Retour</a>
        <h1 class="h4 mb-0 fw-bold">
            {{ invoice.number ?? 'Brouillon' }}
            {{ invoice_status_badge(invoice.status) }}
        </h1>
    </div>
    {# Actions contextuelles selon le statut — turbo-frame pour mise à jour sans rechargement #}
    <turbo-frame id="invoice-actions-{{ invoice.id }}" class="d-flex gap-2 flex-wrap">
        {% if invoice.status.value == 'DRAFT' %}
            <a href="{{ path('app_invoices_edit', {id: invoice.id}) }}" class="btn btn-outline-secondary btn-sm">Modifier</a>
            <form method="POST" action="{{ path('app_invoices_validate', {id: invoice.id}) }}" class="d-inline" data-turbo-stream="true">
                <input type="hidden" name="_token" value="{{ csrf_token('invoice_' ~ invoice.id) }}">
                <button type="submit" class="btn btn-primary btn-sm">Valider la facture</button>
            </form>
        {% elseif invoice.status.value == 'VALIDATED' %}
            <form method="POST" action="{{ path('app_invoices_send', {id: invoice.id}) }}" class="d-inline" data-turbo-stream="true">
                <input type="hidden" name="_token" value="{{ csrf_token('invoice_' ~ invoice.id) }}">
                <button type="submit" class="btn btn-primary btn-sm">Transmettre au PDP/PPF</button>
            </form>
        {% elseif invoice.status.value == 'ACKNOWLEDGED' %}
            <a href="{{ path('app_invoices_credit_note', {id: invoice.id}) }}" class="btn btn-outline-warning btn-sm">Émettre un avoir</a>
        {% endif %}
        {% if invoice.pdfS3Key %}
            <a href="{{ path('app_invoices_download', {id: invoice.id}) }}" class="btn btn-outline-primary btn-sm">⬇ PDF</a>
        {% endif %}
        <form method="POST" action="{{ path('app_invoices_duplicate', {id: invoice.id}) }}" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('invoice_' ~ invoice.id) }}">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Dupliquer</button>
        </form>
    </turbo-frame>
</div>

<div class="row g-4">
    {# Colonne principale #}
    <div class="col-lg-8">

        {# Informations générales #}
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="text-muted small mb-1">Client</div>
                        <div class="fw-semibold">{{ invoice.clientNameSnapshot ?? invoice.contact?.name ?? '—' }}</div>
                        {% if invoice.clientSiretSnapshot %}<div class="small text-muted">SIRET : {{ invoice.clientSiretSnapshot }}</div>{% endif %}
                    </div>
                    <div class="col-sm-2">
                        <div class="text-muted small mb-1">Date d'émission</div>
                        <div class="fw-semibold">{{ invoice.issueDate|date_fr }}</div>
                    </div>
                    <div class="col-sm-2">
                        <div class="text-muted small mb-1">Échéance</div>
                        <div class="fw-semibold {{ invoice.dueDate and invoice.dueDate < date() and invoice.status.value not in ['PAID','CANCELLED'] ? 'text-danger' : '' }}">
                            {{ invoice.dueDate ? invoice.dueDate|date_fr : '—' }}
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <div class="text-muted small mb-1">Format</div>
                        <div class="fw-semibold">{{ invoice.format.value }}</div>
                    </div>
                    <div class="col-sm-2">
                        <div class="text-muted small mb-1">Réf. client</div>
                        <div class="fw-semibold">{{ invoice.clientReference ?? '—' }}</div>
                    </div>
                </div>
                {% if invoice.subject %}
                <div class="mt-3 pt-3 border-top">
                    <span class="text-muted small">Objet :</span>
                    <span class="ms-2">{{ invoice.subject }}</span>
                </div>
                {% endif %}
            </div>
        </div>

        {# Lignes #}
        <div class="card border-0 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Désignation</th>
                            <th class="text-end">Qté</th>
                            <th class="text-end">PU HT</th>
                            <th class="text-end">Rem.</th>
                            <th class="text-end">TVA</th>
                            <th class="text-end">Montant HT</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in invoice.lines %}
                        <tr {% if line.isComment %}class="table-info"{% endif %}>
                            <td>
                                {% if line.reference %}<div class="text-muted small">{{ line.reference }}</div>{% endif %}
                                <div>{{ line.description }}</div>
                            </td>
                            {% if line.isComment %}
                                <td colspan="5"></td>
                            {% else %}
                                <td class="text-end">{{ line.quantity|money }}{{ line.unit }}</td>
                                <td class="text-end">{{ line.unitPrice|money }}</td>
                                <td class="text-end">{{ line.discount != '0.00' ? line.discount ~ '%' : '—' }}</td>
                                <td class="text-end">{{ line.tvaRate }}%</td>
                                <td class="text-end fw-semibold">{{ line.amountHt|money(invoice.currency) }} }}</td>
                            {% endif %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    {# Colonne latérale #}
    <div class="col-lg-4">

        {# Totaux #}
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Total HT</span>
                    <span class="fw-semibold">{{ invoice.totalHt|money(invoice.currency) }} }}</span>
                </div>
                {% for rate, amounts in tvaBreakdown %}
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>TVA {{ rate }}%</span>
                    <span>{{ amounts.tva|money(invoice.currency) }} }}</span>
                </div>
                {% endfor %}
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-bold fs-6">Total TTC</span>
                    <span class="fw-bold fs-6">{{ invoice.totalTtc|money(invoice.currency) }} }}</span>
                </div>
                {% if invoice.amountPaid != '0.00' %}
                <div class="d-flex justify-content-between mb-2 text-success">
                    <span>Payé</span>
                    <span>{{ invoice.amountPaid|money(invoice.currency) }} }}</span>
                </div>
                <div class="d-flex justify-content-between fw-bold text-{{ remainingDue == '0.00' ? 'success' : 'danger' }}">
                    <span>Reste à payer</span>
                    <span>{{ remainingDue|money(invoice.currency) }} }}</span>
                </div>
                {% endif %}
            </div>
        </div>

        {# Timeline statuts #}
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent fw-semibold">Historique</div>
            <div class="card-body px-3 py-2">
                {% for entry in invoice.statusHistory %}
                <div class="d-flex gap-2 py-2 border-bottom">
                    <div class="text-muted small" style="min-width:75px">{{ entry.createdAt|date('d/m H:i') }}</div>
                    <div>
                        {{ invoice_status_badge(entry.toStatus) }}
                        {% if entry.comment %}<div class="text-muted small mt-1">{{ entry.comment }}</div>{% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# Avoirs liés #}
        {% if creditNotes|length > 0 %}
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold">Avoirs</div>
            <div class="list-group list-group-flush">
                {% for cn in creditNotes %}
                <a href="{{ path('app_invoices_show', {id: cn.id}) }}" class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between">
                        <span>{{ cn.number ?? 'Brouillon' }}</span>
                        {{ invoice_status_badge(cn.status) }}
                    </div>
                    <div class="text-muted small">{{ cn.totalTtc|money(invoice.currency) }} }}</div>
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}

    </div>
</div>
{% endblock %}
