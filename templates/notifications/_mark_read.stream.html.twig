{#
 # Turbo Stream — marquer une notification comme lue.
 #
 # Actions :
 #   1. Retirer le style "non lue" de la ligne (bg-light, point bleu)
 #   2. Supprimer le bouton de fermeture
 #   3. Mettre à jour le badge dans le header
 #}

{{# Retirer le style non-lue de la ligne #}}
<turbo-stream action="morph" target="notif-{{ notif.id }}">
    <template>
        <div id="notif-{{ notif.id }}"
             class="d-flex gap-3 px-3 py-3 border-bottom"
             style="opacity:.75">
            <div class="flex-shrink-0 mt-1">
                <span class="rounded-circle d-inline-block"
                      style="width:7px;height:7px;background:transparent"></span>
            </div>
            <div class="flex-grow-1 min-w-0">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="fw-semibold small text-muted">{{ notif.title }}</div>
                    <div class="text-muted small flex-shrink-0">{{ notif.createdAt|date_fr }}</div>
                </div>
                <div class="text-muted small mt-1">{{ notif.description }}</div>
            </div>
        </div>
    </template>
</turbo-stream>

{{# Mettre à jour le badge du header #}}
<turbo-stream action="replace" target="notifications-count">
    <template>
        <turbo-frame id="notifications-count"
                     class="position-absolute top-0 start-100 translate-middle"
                     src="{{ path('app_notifications_api_count') }}"
                     refresh="morph">
        </turbo-frame>
    </template>
</turbo-stream>
