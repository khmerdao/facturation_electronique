{% extends 'base.html.twig' %}
{% block page_title %}Notifications{% endblock %}

{% block main %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <h1 class="h4 mb-0 fw-bold">Notifications</h1>
        {% if unreadCount > 0 %}
            <span class="badge bg-danger">{{ unreadCount }} non lue{{ unreadCount > 1 ? 's' : '' }}</span>
        {% endif %}
    </div>
    <div class="d-flex gap-2">
        {# Filtre lu/non-lu #}
        <div class="btn-group btn-group-sm">
            <a href="{{ path('app_notifications_index') }}"
               class="btn {{ filter == 'all' ? 'btn-primary' : 'btn-outline-secondary' }}">
                Toutes
            </a>
            <a href="{{ path('app_notifications_index') }}?filter=unread"
               class="btn {{ filter == 'unread' ? 'btn-primary' : 'btn-outline-secondary' }}">
                Non lues
            </a>
        </div>
        {% if unreadCount > 0 %}
            <form method="POST" action="{{ path('app_notifications_read_all') }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('notif_read_all') }}">
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    ✓ Tout marquer comme lu
                </button>
            </form>
        {% endif %}
    </div>
</div>

<div class="card border-0 shadow-sm">
    {% if notifications|length == 0 %}
        <div class="text-center text-muted py-5">
            <svg width="48" height="48" viewBox="0 0 20 20" fill="currentColor"
                 class="d-block mx-auto mb-3 opacity-25">
                <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/>
            </svg>
            <p class="fw-medium mb-0">Aucune notification</p>
            <p class="small mb-0">Vous êtes à jour !</p>
        </div>
    {% else %}
        <div class="list-group list-group-flush" id="notification-list">
            {% for notif in notifications %}
            {# Couleur selon sévérité #}
            {% set severityColor = {
                'INFO':    'primary',
                'SUCCESS': 'success',
                'WARNING': 'warning',
                'DANGER':  'danger'
            } %}
            {% set color = severityColor[notif.severity.value] ?? 'secondary' %}

            <div class="list-group-item list-group-item-action py-3 pe-3
                        {{ notif.readAt is null ? 'bg-light' : '' }}"
                 id="notif-{{ notif.id }}"
                 data-notif-id="{{ notif.id }}"
                 data-read="{{ notif.readAt is not null ? 'true' : 'false' }}">
                <div class="d-flex gap-3 align-items-start">

                    {# Icône sévérité #}
                    <div class="flex-shrink-0 mt-1">
                        <span class="d-flex align-items-center justify-content-center rounded-circle bg-{{ color }} bg-opacity-10 text-{{ color }}"
                              style="width:36px;height:36px">
                            {% if notif.severity.value == 'SUCCESS' %}
                                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            {% elseif notif.severity.value == 'DANGER' %}
                                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                            {% elseif notif.severity.value == 'WARNING' %}
                                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                            {% else %}
                                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
                            {% endif %}
                        </span>
                    </div>

                    {# Contenu #}
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div class="fw-semibold {{ notif.readAt is null ? '' : 'text-muted fw-normal' }}">
                                {{ notif.title }}
                                {% if notif.readAt is null %}
                                    <span class="d-inline-block rounded-circle bg-{{ color }} ms-1"
                                          style="width:7px;height:7px;vertical-align:middle"></span>
                                {% endif %}
                            </div>
                            <span class="text-muted small flex-shrink-0">
                                {{ notif.createdAt|date('d/m H:i') }}
                            </span>
                        </div>
                        {% if notif.description %}
                            <div class="text-muted small mt-1">{{ notif.description }}</div>
                        {% endif %}
                        {% if notif.actionUrl %}
                            <a href="{{ notif.actionUrl }}" class="btn btn-sm btn-outline-{{ color }} mt-2">
                                {{ notif.actionLabel ?? 'Voir' }}
                            </a>
                        {% endif %}
                    </div>

                    {# Bouton marquer comme lu #}
                    {% if notif.readAt is null %}
                    <button type="button"
                            class="btn-close flex-shrink-0 mark-read-btn"
                            aria-label="Marquer comme lu"
                            data-notif-id="{{ notif.id }}"
                            title="Marquer comme lu">
                    </button>
                    {% endif %}

                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Marquer une notification comme lue sans rechargement
document.querySelectorAll('.mark-read-btn').forEach(btn => {
    btn.addEventListener('click', async function(e) {
        e.preventDefault();
        const notifId = this.dataset.notifId;
        const row     = document.getElementById('notif-' + notifId);

        try {
            await fetch('{{ path("app_notifications_read", {"id": "__ID__"}) }}'.replace('__ID__', notifId), {
                method: 'POST',
                headers: {
                    'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content ?? '',
                },
            });
            // Retirer le fond coloré et le point bleu
            row.classList.remove('bg-light');
            row.querySelector('.mark-read-btn')?.remove();
            row.querySelectorAll('[class*="rounded-circle bg-"]').forEach(el => {
                if (el.style.width === '7px') el.remove();
            });
            // Décrementer le badge global
            const badge = document.querySelector('.badge.bg-danger');
            if (badge) {
                const count = parseInt(badge.textContent) - 1;
                if (count <= 0) badge.remove();
                else badge.textContent = count + ' non lue' + (count > 1 ? 's' : '');
            }
        } catch (e) {
            console.error('Erreur marquage notification', e);
        }
    });
});
</script>
{% endblock %}
