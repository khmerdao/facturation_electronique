{#
 # Sidebar de navigation principale
 # Gérée comme Turbo Permanent (persiste entre les navigations Turbo)
 #}
<aside class="app-sidebar" id="app-sidebar" data-turbo-permanent
       data-controller="sidebar">

    {# ── Logo / Brand ─────────────────────────────────────────────────────── #}
    <div class="app-sidebar__brand">
        <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center gap-2 text-white text-decoration-none">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect width="28" height="28" rx="6" fill="var(--brand-color, #2563EB)"/>
                <path d="M7 8h14M7 14h10M7 20h8" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="fw-semibold fs-6">{{ app_name }}</span>
        </a>
    </div>

    {# ── Navigation principale ─────────────────────────────────────────────── #}
    <nav class="app-sidebar__nav" aria-label="Navigation principale">
        <ul class="list-unstyled mb-0">
            <li>
                <a href="{{ path('app_dashboard') }}"
                   class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_dashboard' ? 'active' : '' }}">
                    <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/></svg>
                    Tableau de bord
                </a>
            </li>

            {# ── Facturation ───────────────────────────────────────────────── #}
            <li class="mt-3 px-3 mb-1">
                <small class="text-uppercase text-muted" style="font-size:.7rem;letter-spacing:.08em">Facturation</small>
            </li>
            <li>
                <a href="{{ path('app_invoices_index') }}"
                   class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_invoices' ? 'active' : '' }}">
                    <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/></svg>
                    Factures émises
                    {# Badge compteur factures en attente #}
                </a>
            </li>
            <li>
                <a href="{{ path('app_received_invoices_index') }}"
                   class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_received_invoices' ? 'active' : '' }}">
                    <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M3 3a1 1 0 000 2h11a1 1 0 100-2H3zM3 7a1 1 0 000 2h5a1 1 0 000-2H3zM3 11a1 1 0 100 2h4a1 1 0 100-2H3zM13 16a1 1 0 102 0v-5.586l1.293 1.293a1 1 0 001.414-1.414l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 101.414 1.414L13 10.414V16z"/></svg>
                    Factures reçues
                </a>
            </li>
            <li>
                <a href="{{ path('app_payments_index') }}"
                   class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_payments' ? 'active' : '' }}">
                    <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/></svg>
                    Paiements
                </a>
            </li>

            {# ── Contacts & Catalogue ──────────────────────────────────────── #}
            <li class="mt-3 px-3 mb-1">
                <small class="text-uppercase text-muted" style="font-size:.7rem;letter-spacing:.08em">Données</small>
            </li>
            <li>
                <a href="{{ path('app_contacts_index') }}"
                   class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_contacts' ? 'active' : '' }}">
                    <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
                    Contacts
                </a>
            </li>
            <li>
                <a href="{{ path('app_products_index') }}"
                   class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_products' ? 'active' : '' }}">
                    <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"/></svg>
                    Catalogue
                </a>
            </li>

            {# ── Conformité ────────────────────────────────────────────────── #}
            <li class="mt-3 px-3 mb-1">
                <small class="text-uppercase text-muted" style="font-size:.7rem;letter-spacing:.08em">Conformité</small>
            </li>
            <li>
                <a href="{{ path('app_e_reporting_index') }}"
                   class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_e_reporting' ? 'active' : '' }}">
                    <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11 4a1 1 0 10-2 0v4a1 1 0 102 0V7zm-3 1a1 1 0 10-2 0v3a1 1 0 102 0V8zM8 9a1 1 0 00-2 0v2a1 1 0 102 0V9z" clip-rule="evenodd"/></svg>
                    E-reporting
                </a>
            </li>
            <li>
                <a href="{{ path('app_tax_index') }}"
                   class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_tax' ? 'active' : '' }}">
                    <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 2a2 2 0 00-2 2v14l3.5-2 3.5 2 3.5-2 3.5 2V4a2 2 0 00-2-2H5zm2.5 3a1.5 1.5 0 100 3 1.5 1.5 0 000-3zm6.207.293a1 1 0 00-1.414 0l-6 6a1 1 0 101.414 1.414l6-6a1 1 0 000-1.414zM12.5 10a1.5 1.5 0 100 3 1.5 1.5 0 000-3z" clip-rule="evenodd"/></svg>
                    TVA & Exports
                </a>
            </li>
        </ul>
    </nav>

    {# ── Pied de sidebar ─────────────────────────────────────────────────── #}
    <div class="app-sidebar__footer">
        <a href="{{ path('app_settings_organisation') }}"
           class="app-sidebar__nav-link {{ app.request.attributes.get('_route') starts with 'app_settings' ? 'active' : '' }}">
            <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
            Paramètres
        </a>
    </div>

</aside>
