{% extends 'base.html.twig' %}
{% block page_title %}Paiements{% endblock %}
{% block main %}
<h1 class="h4 fw-bold mb-4">Paiements</h1>
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="GET" class="row g-2">
            <div class="col-md-3">
                <select name="direction" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    <option value="INCOMING" {{ filters.direction == 'INCOMING' ? 'selected' : '' }}>Encaissements</option>
                    <option value="OUTGOING" {{ filters.direction == 'OUTGOING' ? 'selected' : '' }}>Décaissements</option>
                </select>
            </div>
            <div class="col-md-2"><input type="date" name="from" class="form-control form-control-sm" value="{{ filters.from ?? '' }}"></div>
            <div class="col-md-2"><input type="date" name="to" class="form-control form-control-sm" value="{{ filters.to ?? '' }}"></div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-secondary btn-sm">Filtrer</button></div>
        </form>
    </div>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Date</th><th>Facture</th><th>Mode</th><th>Référence</th><th class="text-end">Montant</th><th>Direction</th></tr></thead>
            <tbody>
                {% for payment in payments %}
                <tr>
                    <td>{{ payment.date|date('d/m/Y') }}</td>
                    <td>
                        {% if payment.invoice %}
                            <a href="{{ path('app_invoices_show', {id: payment.invoice.id}) }}">{{ payment.invoice.number ?? 'Brouillon' }}</a>
                        {% else %}—{% endif %}
                    </td>
                    <td>{{ payment.mode.label() }}</td>
                    <td class="text-muted small">{{ payment.reference ?? '—' }}</td>
                    <td class="text-end fw-semibold {{ payment.direction.value == 'INCOMING' ? 'text-success' : 'text-danger' }}">
                        {{ payment.direction.value == 'INCOMING' ? '+' : '-' }}{{ payment.amount|number_format(2,',',' ') }} {{ payment.currency }}
                    </td>
                    <td><span class="badge {{ payment.direction.value == 'INCOMING' ? 'bg-success' : 'bg-danger' }}">{{ payment.direction.value }}</span></td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center text-muted py-5">Aucun paiement enregistré.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
