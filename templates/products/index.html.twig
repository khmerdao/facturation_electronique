{% extends 'base.html.twig' %}
{% block page_title %}Catalogue{% endblock %}
{% block main %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 mb-0 fw-bold">Catalogue produits & services</h1>
    <a href="{{ path('app_products_new') }}" class="btn btn-primary btn-sm">+ Nouveau</a>
</div>
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="GET" class="row g-2">
            <div class="col-md-5"><input type="text" name="q" class="form-control form-control-sm" placeholder="Rechercher référence ou libellé…" value="{{ q ?? '' }}"></div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-secondary btn-sm">Filtrer</button></div>
        </form>
    </div>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Référence</th><th>Libellé</th><th>Type</th><th class="text-end">Prix HT</th><th class="text-end">TVA</th><th></th></tr></thead>
            <tbody>
                {% for product in products %}
                <tr>
                    <td class="font-monospace small">{{ product.reference }}</td>
                    <td><a href="{{ path('app_products_show', {id: product.id}) }}" class="fw-semibold text-decoration-none">{{ product.label }}</a></td>
                    <td><span class="badge bg-secondary">{{ product.type.value }}</span></td>
                    <td class="text-end fw-semibold">{{ product.unitPrice|money }}</td>
                    <td class="text-end">{{ product.tvaRate }}%</td>
                    <td>
                        <a href="{{ path('app_products_edit', {id: product.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center text-muted py-5">Aucun produit. <a href="{{ path('app_products_new') }}">Créer le premier</a></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
