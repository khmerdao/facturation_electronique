{% extends 'base.html.twig' %}
{% block page_title %}{{ product.label }}{% endblock %}
{% block main %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_products_index') }}" class="btn btn-sm btn-outline-secondary">← Retour</a>
        <h1 class="h4 mb-0 fw-bold">{{ product.label }}</h1>
        <span class="badge bg-secondary">{{ product.type.value }}</span>
    </div>
    <a href="{{ path('app_products_edit', {id: product.id}) }}" class="btn btn-outline-secondary btn-sm">Modifier</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-sm-3"><div class="text-muted small">Référence</div><div class="font-monospace">{{ product.reference }}</div></div>
            <div class="col-sm-3"><div class="text-muted small">Prix HT</div><div class="fw-bold fs-5">{{ product.unitPrice|number_format(2,',',' ') }} €</div></div>
            <div class="col-sm-2"><div class="text-muted small">TVA</div><div>{{ product.tvaRate }}%</div></div>
            <div class="col-sm-2"><div class="text-muted small">Unité</div><div>{{ product.unit }}</div></div>
            {% if product.accountingCode %}<div class="col-sm-2"><div class="text-muted small">Code compta</div><div>{{ product.accountingCode }}</div></div>{% endif %}
        </div>
        {% if product.description %}<div class="mt-3 pt-3 border-top">{{ product.description }}</div>{% endif %}
    </div>
</div>
{% endblock %}
