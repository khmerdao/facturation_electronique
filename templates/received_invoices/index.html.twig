{% extends 'base.html.twig' %}
{% block page_title %}Factures reçues{% endblock %}

{% block main %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 mb-0 fw-bold">Factures reçues</h1>
    {% if pendingAck > 0 %}
    <span class="badge bg-warning text-dark fs-6">
        {{ pendingAck }} en attente d'acquittement
    </span>
    {% endif %}
</div>

{# KPIs #}
{% if kpis is defined %}
<div class="row g-3 mb-4">
    <div class="col-sm-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="h4 mb-0 fw-bold">{{ kpis.pending ?? 0 }}</div>
            <div class="text-muted small">À valider</div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="h4 mb-0 fw-bold text-success">{{ kpis.approved ?? 0 }}</div>
            <div class="text-muted small">Validées</div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="h4 mb-0 fw-bold text-warning">{{ kpis.contested ?? 0 }}</div>
            <div class="text-muted small">Contestées</div>
        </div>
    </div>
    <div class="col-sm-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="h4 mb-0 fw-bold text-danger">{{ kpis.parseErrors ?? 0 }}</div>
            <div class="text-muted small">Erreurs de lecture</div>
        </div>
    </div>
</div>
{% endif %}

{# Filtres #}
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="GET" class="row g-2">
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">Tous les statuts</option>
                    {% for status in statuses %}
                    <option value="{{ status.value }}" {{ filters.status == status.value ? 'selected' : '' }}>
                        {{ status.label() }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="from" class="form-control form-control-sm" value="{{ filters.from ?? '' }}">
            </div>
            <div class="col-md-3">
                <input type="date" name="to" class="form-control form-control-sm" value="{{ filters.to ?? '' }}">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Filtrer</button>
            </div>
        </form>
    </div>
</div>

{# Tableau #}
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>N° facture fournisseur</th>
                    <th>Fournisseur</th>
                    <th>Date facture</th>
                    <th>Reçue le</th>
                    <th class="text-end">Montant TTC</th>
                    <th class="text-center">Statut</th>
                    <th class="text-center">Acq. tech.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for invoice in invoices %}
                <tr class="{{ invoice.parseErrors ? 'table-danger' : '' }}">
                    <td>
                        <a href="{{ path('app_received_invoices_show', {id: invoice.id}) }}" class="fw-semibold text-decoration-none">
                            {{ invoice.invoiceNumber ?? '—' }}
                        </a>
                    </td>
                    <td>{{ invoice.supplierName ?? invoice.supplierContact?.name ?? '—' }}</td>
                    <td>{{ invoice.invoiceDate ? invoice.invoiceDate|date_fr : '—' }}</td>
                    <td>{{ invoice.receivedAt|date('d/m/Y H:i') }}</td>
                    <td class="text-end fw-semibold">
                        {{ invoice.amountTtc ? invoice.amountTtc|money ~ ' ' ~ invoice.currency : '—' }}
                    </td>
                    <td class="text-center">
                        {{ invoice_status_badge(invoice.status) }}
                    </td>
                    <td class="text-center">
                        {% if invoice.technicalAckSentAt %}
                            <span class="text-success" title="{{ invoice.technicalAckSentAt|date('d/m/Y H:i') }}">✓</span>
                        {% else %}
                            <span class="text-warning">En attente</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_received_invoices_show', {id: invoice.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center text-muted py-5">
                        Aucune facture reçue. Elles apparaîtront automatiquement dès que votre PDP en transmettra.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
