{% extends 'base.html.twig' %}
{% block page_title %}Intégrations{% endblock %}
{% block main %}
<h1 class="h4 fw-bold mb-4">Paramètres — Intégrations</h1>
{% include 'settings/_nav.html.twig' %}

<div class="card border-0 shadow-sm mt-4 mb-4">
    <div class="card-header fw-semibold bg-transparent">Clés API ({{ apiKeys|length }})</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Nom</th><th>Préfixe</th><th>Environnement</th><th>Dernière utilisation</th><th>Expire</th></tr></thead>
            <tbody>
                {% for key in apiKeys %}
                <tr>
                    <td>{{ key.name }}</td>
                    <td class="font-monospace small">{{ key.keyPrefix }}...</td>
                    <td><span class="badge bg-{{ key.environment.value == 'PRODUCTION' ? 'danger' : 'warning text-dark' }}">{{ key.environment.value }}</span></td>
                    <td>{{ key.lastUsedAt ? key.lastUsedAt|date('d/m/Y H:i') : 'Jamais' }}</td>
                    <td>{{ key.expiresAt ? key.expiresAt|date('d/m/Y') : 'Jamais' }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-muted py-3">Aucune clé API.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header fw-semibold bg-transparent">Webhooks ({{ webhooks|length }})</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>URL</th><th>Événements</th><th>Actif</th><th>Dernière livraison</th></tr></thead>
            <tbody>
                {% for wh in webhooks %}
                <tr>
                    <td class="font-monospace small">{{ wh.url|slice(0, 50) }}...</td>
                    <td class="small text-muted">{{ wh.events|join(', ') }}</td>
                    <td>{{ wh.active ? '<span class="badge bg-success">Actif</span>'|raw : '<span class="badge bg-secondary">Inactif</span>'|raw }}</td>
                    <td>{{ wh.lastSuccessAt ? wh.lastSuccessAt|date('d/m/Y H:i') : '—' }}</td>
                </tr>
                {% else %}
                <tr><td colspan="4" class="text-center text-muted py-3">Aucun webhook configuré.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
