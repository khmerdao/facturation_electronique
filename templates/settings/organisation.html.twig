{% extends 'base.html.twig' %}
{% block page_title %}Organisation{% endblock %}
{% block main %}
<h1 class="h4 fw-bold mb-4">Paramètres — Organisation</h1>
{% include 'settings/_nav.html.twig' %}
<div class="card border-0 shadow-sm mt-4">
    <div class="card-body">
        <form method="POST" action="{{ path('app_settings_organisation') }}">
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label fw-medium">Nom *</label><input type="text" name="name" class="form-control" value="{{ tenant.name }}" required></div>
                <div class="col-md-4"><label class="form-label fw-medium">SIRET</label><input type="text" name="siret" class="form-control" value="{{ tenant.siret }}" maxlength="14"></div>
                <div class="col-md-4"><label class="form-label fw-medium">N° TVA intracommunautaire</label><input type="text" name="tva_intra" class="form-control" value="{{ tenant.tvaIntra }}"></div>
                <div class="col-md-4"><label class="form-label fw-medium">Email facturation</label><input type="email" name="billing_email" class="form-control" value="{{ tenant.billingEmail }}"></div>
                <div class="col-md-4"><label class="form-label fw-medium">Téléphone</label><input type="text" name="phone" class="form-control" value="{{ tenant.phone }}"></div>
                <div class="col-md-6"><label class="form-label fw-medium">IBAN</label><input type="text" name="iban" class="form-control" value="{{ tenant.iban }}"></div>
                <div class="col-md-3"><label class="form-label fw-medium">BIC</label><input type="text" name="bic" class="form-control" value="{{ tenant.bic }}"></div>
                <div class="col-12"><hr><h6 class="fw-semibold">Adresse</h6></div>
                <div class="col-12"><input type="text" name="addr_line1" class="form-control" placeholder="Ligne 1" value="{{ tenant.address.line1 }}"></div>
                <div class="col-12"><input type="text" name="addr_line2" class="form-control" placeholder="Ligne 2" value="{{ tenant.address.line2 }}"></div>
                <div class="col-md-3"><input type="text" name="addr_postal_code" class="form-control" placeholder="Code postal" value="{{ tenant.address.postalCode }}"></div>
                <div class="col-md-6"><input type="text" name="addr_city" class="form-control" placeholder="Ville" value="{{ tenant.address.city }}"></div>
                <div class="col-md-3"><input type="text" name="addr_country" class="form-control" value="{{ tenant.address.country ?? 'FR' }}"></div>
            </div>
            <div class="mt-4"><button type="submit" class="btn btn-primary">Enregistrer</button></div>
            <input type="hidden" name="_token" value="{{ csrf_token('settings_organisation') }}">
</form>
    </div>
</div>
{% endblock %}
