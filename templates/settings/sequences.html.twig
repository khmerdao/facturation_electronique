{% extends 'base.html.twig' %}
{% block page_title %}Séquences de numérotation{% endblock %}
{% block main %}
<h1 class="h4 fw-bold mb-4">Paramètres — Séquences</h1>
{% include 'settings/_nav.html.twig' %}
<div class="card border-0 shadow-sm mt-4 mb-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Nom</th><th>Préfixe</th><th>Prochain numéro</th><th>Verrouillée</th><th>Type</th></tr></thead>
            <tbody>
                {% for seq in sequences %}
                <tr>
                    <td>{{ seq.name }}</td>
                    <td class="font-monospace">{{ seq.prefix }}</td>
                    <td>{{ seq.preview is defined ? seq.preview : seq.nextNumber }}</td>
                    <td>{{ seq.locked ? '<span class="badge bg-warning text-dark">Verrouillée</span>'|raw : '<span class="badge bg-success">Modifiable</span>'|raw }}</td>
                    <td>{{ seq.creditNoteSequence ? 'Avoirs' : 'Factures' }}</td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">Aucune séquence.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-header fw-semibold bg-transparent">Créer une séquence</div>
    <div class="card-body">
        <form method="POST" action="{{ path('app_settings_sequences') }}" class="row g-3">
            <input type="hidden" name="action" value="create">
            <div class="col-md-4"><label class="form-label fw-medium">Nom</label><input type="text" name="name" class="form-control" required></div>
            <div class="col-md-3"><label class="form-label fw-medium">Préfixe</label><input type="text" name="prefix" class="form-control" value="FAC"></div>
            <div class="col-md-3">
                <label class="form-label fw-medium">Type</label>
                <select name="is_credit_note_sequence" class="form-select">
                    <option value="0">Factures</option>
                    <option value="1">Avoirs</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-primary w-100">Créer</button></div>
        </form>
    </div>
</div>
{% endblock %}
