{% extends 'base.html.twig' %}
{% block page_title %}TVA & Comptabilité{% endblock %}
{% block main %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h4 mb-0 fw-bold">TVA & Comptabilité</h1>
    <a href="{{ path('app_tax_exports') }}" class="btn btn-outline-secondary btn-sm">Exports</a>
</div>

{# Filtre période #}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="GET" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-medium mb-1">Année</label>
                <select name="year" class="form-select form-select-sm">
                    {% for y in years %}<option value="{{ y }}" {{ year == y ? 'selected' : '' }}>{{ y }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label fw-medium mb-1">Mois</label>
                <select name="month" class="form-select form-select-sm">
                    <option value="0" {{ month == 0 ? 'selected' : '' }}>Toute l'année</option>
                    {% for m in 1..12 %}
                    <option value="{{ m }}" {{ month == m ? 'selected' : '' }}>
                        {{ (from|date_modify((m - 1) ~ ' months'))|date('F') }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Calculer</button>
            </div>
        </form>
    </div>
</div>

{# Tableau TVA #}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header fw-semibold bg-transparent">
        Décomposition TVA — {{ from|date_fr }} au {{ to|date_fr }}
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Taux TVA</th>
                    <th class="text-end">Base HT</th>
                    <th class="text-end">TVA collectée</th>
                    <th class="text-end">Total TTC</th>
                </tr>
            </thead>
            <tbody>
                {% set totalHt = 0 %}
                {% set totalTva = 0 %}
                {% for row in tvaStats %}
                    {% set totalHt = totalHt + row.totalHt %}
                    {% set totalTva = totalTva + row.totalTva %}
                    <tr>
                        <td><span class="badge bg-secondary">{{ row.tvaRate }}%</span></td>
                        <td class="text-end">{{ row.totalHt|money }}</td>
                        <td class="text-end fw-semibold">{{ row.totalTva|money }}</td>
                        <td class="text-end">{{ (row.totalHt + row.totalTva)|money }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-center text-muted py-4">Aucune donnée pour cette période.</td></tr>
                {% endfor %}
            </tbody>
            {% if tvaStats|length > 0 %}
            <tfoot class="table-light fw-bold">
                <tr>
                    <td>Total</td>
                    <td class="text-end">{{ totalHt|money }}</td>
                    <td class="text-end">{{ totalTva|money }}</td>
                    <td class="text-end">{{ (totalHt + totalTva)|money }}</td>
                </tr>
            </tfoot>
            {% endif %}
        </table>
    </div>
</div>

{# Export FEC rapide #}
<div class="card border-0 shadow-sm">
    <div class="card-header fw-semibold bg-transparent">Export FEC rapide</div>
    <div class="card-body">
        <p class="text-muted small">Génère le Fichier des Écritures Comptables (art. A47 A-1 CGI) pour la période affichée.</p>
        <form method="POST" action="{{ path('app_tax_export_new') }}">
            <input type="hidden" name="type" value="FEC">
            <input type="hidden" name="from" value="{{ from|date('Y-m-d') }}">
            <input type="hidden" name="to" value="{{ to|date('Y-m-d') }}">
            <button type="submit" class="btn btn-outline-primary btn-sm">
                Générer le FEC {{ from|date('Y') }}
            </button>
            <input type="hidden" name="_token" value="{{ csrf_token('tax_fec_export') }}">
</form>
    </div>
</div>
{% endblock %}
